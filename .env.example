# Пример настроек. Файл .env необязателен: у всех переменных есть значения
# по умолчанию в compose.yaml. Чтобы изменить значения, скопируйте этот файл в .env.
# Здесь нет секретов: это локальные демонстрационные значения.

# PostgreSQL (контейнер db; порт наружу не публикуется)
POSTGRES_USER=contest
POSTGRES_PASSWORD=contest
POSTGRES_DB=contest

# Порт backend на машине разработчика: http://localhost:8000
BACKEND_PORT=8000

# Срок жизни сессии входа, часов
SESSION_TTL_HOURS=24

# Демо-аккаунты: создавать при старте и их общий публичный пароль
SEED_DEMO_DATA=true
DEMO_PASSWORD=demo-password
